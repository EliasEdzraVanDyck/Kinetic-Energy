  pauseAction: {fileID: -7789732244773758374, guid: 052faaac586de48259a63d0c4782560b, type: 3}
  pausePanel: {fileID: 1446320042020035226}
  controlsPanel: {fileID: 435651479708152661}
  scenesPanel: {fileID: 4271338959619817147}
  firstPauseButton: {fileID: 4900223479901787380}
  firstControlsButton: {fileID: 3081449395536939499}
  firstScenesButton: {fileID: 578160398310611305}
  controlsText: 'Left Stick - Move (on the ground, while not aiming)

    Left Stick
    (in the air) - Nudge distance / drift sideways

    Left Trigger - Aim (hold;
    the cube stays put)

    Left Stick (while aiming) - Adjust aim direction

    Right
    Trigger - Launch

    South - Show/hide the landing preview

    Right Stick
    - Camera

    Start / Options / Esc - Pause


    (Hold-Release and Analog launch
    schemes are still in the project, just disabled)'
  controlsBodyText: {fileID: 9211400013750177863}
