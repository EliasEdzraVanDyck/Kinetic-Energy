  totalLossBaseRefund: 1
  totalLossStepPerLevel: 0.05
  totalLossSafetyTriggerFraction: 0.1
  totalLossSafetyCeilingFraction: 0.4
  introKey: level1economy
  introText: "HOW THIS LEVEL'S ENERGY WORKS\n\nTHE METER: the first 4 blocks (40%)
    are normal energy. The 6 taller blocks are boosted energy, only combo bonuses
    and the groundpound boost can fill them.\n\nCOMBOS: a succesful launch refunds
    the energy of your launch(es) times the combo multiplier. \nRelaunch within the
    window to raise the multiplier. Landing back on the object you launched from
    pays nothing.\nIf you miss the window, your energy reverts to 40%, everything
    boosted is lost.\n\nGROUND POUND: if you groundpound and aim within the slow-mo
    window, the pound pays\nback 1.5x what you put in.\n\nReach the finish to win.\n\nPress
    any button to start."
  safetyTriggerFraction: 0.1
  safetyCeilingFraction: 0.4
  regenPerSecond: 0.12
  regenOrangeFadeSeconds: 0.4
