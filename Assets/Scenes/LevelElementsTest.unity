  m_Script: {fileID: 11500000, guid: b78d2b2643066bd4c8dab4033ce5dbd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KineticEnergy.Level.MergedEconomyController
  currentVariant: 4
  autoMaxEnergy: 0
  comboBaseRefund: 1
  comboStepPerLevel: 0.05
  comboWindowSeconds: 5.2
  comboMaxMultiplier: 2
  comboMeterDropPixels: 20
  comboMeterColor: {r: 1, g: 0.62, b: 0.1, a: 1}
  comboIdleColor: {r: 0.55, g: 0.55, b: 0.55, a: 0.9}
  firstLaunchBaseRefund: 0.9
  firstLaunchStepPerLevel: 0.05
  midairLaunchBaseRefund: 0.9
  midairLaunchStepPerLevel: 0.05
  dualSafetyTriggerFraction: 0.4
  dualSafetyCeilingFraction: 0.4
  totalLossBaseRefund: 1
  totalLossStepPerLevel: 0.05
  totalLossSafetyTriggerFraction: 0.4
  totalLossSafetyCeilingFraction: 0.4
  introKey: levelelements
  introText: "LEVEL ELEMENTS TEST\n\nA straight run along one axis, introducing one
    element at a time. Pause > Sections jumps straight to any of them - you respawn
    there while you keep testing it.\n\n1 - BASICS: plain platforms.\n\n2 - MOVING
    PLATFORMS: one slides sideways, one rides up and down. While you aim, a blue
    arrow shows where the platform will be when your shot lands.\n\n3 - ROTATING
    WALLS: sticky faces that keep turning. \n\n4 - LASERS: gates that blink on and
    off. Cross while they are turned off.\n\n5 - GROUND ENEMIES: they wander their
    platform and leap at you when you are nearby.\n\n6 - FLYING ENEMIES: they drift
    over the gaps and shoot on sight.\n\n7 - TURRETS: fixed wall enemies that also
    shoot on sight.\n\nFALLING: if the combo window runs out while you are in the
    air, the aim is cut short and you fall down. Keep landing before the meter empties.\n\nPress
    any button to start."
  safetyTriggerFraction: 0.4
  safetyCeilingFraction: 0.4
  regenPerSecond: 0.12
  regenOrangeFadeSeconds: 0.4
  wallLaunchStakeFraction: 0.3
  premiumBoundaryFraction: 0.4
  lockSettings: 1
  momentumLaunches: 1
  totalLossKeepFraction: 0.4
  dropPlayerWhenWindowExpires: 1
  showHudTag: 0
  flightSettleSeconds: 0.25
  comboMeter: {fileID: 645746554}
